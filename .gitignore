# -------------------------
node_modules/
.expo/
dist/
web-build/
expo-env.d.ts
.metro-cache/
.metro-health-check*
npm-debug.*
yarn-debug.*
yarn-error.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*
app-example
*.tsbuildinfo

# -------------------------
